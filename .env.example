# Which LLM backend to use: "gemini" (default, free tier) or "openai" (any OpenAI-compatible API:
# OpenAI, Groq, OpenRouter, a local Ollama server, ...)
LLM_PROVIDER=gemini

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- OpenAI-compatible ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=            # e.g. http://localhost:11434/v1 for Ollama, https://api.groq.com/openai/v1 for Groq

# Optional: freeze "today" (YYYY-MM-DD or YYYY-MM-DDTHH:MM) for reproducible demos/tests.
# EMPORIO_NOW=2026-03-20T10:00
